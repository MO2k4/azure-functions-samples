<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test method names use underscores by convention (MethodName_Condition_Expected) -->
    <!-- AD0001: the transitive Durable Task orchestration analyzers throw when scanning
         this test project (analyzer bug, not a real diagnostic); the analyzers still run
         and guard the DurableFunctionsDemo app itself. -->
    <NoWarn>$(NoWarn);CA1707;AD0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.DurableTask.InProcessTestHost" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DurableFunctionsDemo/DurableFunctionsDemo.csproj" />
  </ItemGroup>
</Project>
